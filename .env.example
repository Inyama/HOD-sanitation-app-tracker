# HOD Sanitation Hub environment variables (spec section 12).
# Copy to .env.local and fill in. Never commit real values.

# Phase 8: PostgreSQL (Neon or Supabase)
DATABASE_URL="postgresql://user:password@host:5432/hod_sanitation?sslmode=require"

# Auth.js secret: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""

# Public base URL used in emails and calendar links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo mode: dummy data, Demo ribbon and simulate controls. Defaults to true when unset.
NEXT_PUBLIC_DEMO_MODE="true"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="HOD Sanitation Hub <no-reply@example.com>"

# Web Push (generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Protects POST /api/v1/cron/notifications
CRON_SECRET=""

# File storage for uploads and proofs
STORAGE_BUCKET=""
STORAGE_KEY=""
